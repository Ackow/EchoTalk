# 本地 MySQL 连接信息。复制为 .env 后填写实际密码。
ECHOTALK_DB_HOST=127.0.0.1
ECHOTALK_DB_PORT=3307
ECHOTALK_DB_NAME=echotalk
ECHOTALK_DB_USER=echotalk_app
ECHOTALK_DB_PASSWORD=replace-with-your-password

# 本机默认只监听回环地址；部署时设为 0.0.0.0 并仅通过 HTTPS 反向代理对外提供 API。
ECHOTALK_API_HOST=127.0.0.1
ECHOTALK_API_PORT=8000

# 本地桌面开发来源。生产时替换为实际网页域名；打包 Electron 使用 file:// 时保留 null。
ECHOTALK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# ---- 嵌入（Hybrid RAG）：SiliconFlow OpenAI 兼容接口 ----
# 在 https://cloud.siliconflow.cn 申请 API key 后填入；未配置时嵌入自动停用，检索退化为纯关键词模式。
ECHOTALK_SILICONFLOW_API_KEY=replace-with-your-siliconflow-key

# 以下保持默认即可，仅在需要更换服务商/模型时修改。注意：更换嵌入模型后向量空间不兼容，必须全量重建索引（reindex）。
ECHOTALK_EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
ECHOTALK_EMBEDDING_MODEL=BAAI/bge-m3
ECHOTALK_EMBEDDING_DIM=1024
ECHOTALK_EMBEDDING_TIMEOUT=15
ECHOTALK_EMBEDDING_BATCH=16

# ---- LightRAG（图谱 RAG）：实体抽取 LLM 独立配置（与上面的嵌入 key 分开） ----
# 需 OpenAI 兼容接口的 base_url + key + 模型名（官方建议 ≥32B 非推理模型，默认 DeepSeek-V3）。
# 未配置 LLM key 时 LightRAG 整条链路停用（上传不受影响，仅图谱检索接口报 400）；
# 嵌入仍走上面的 SiliconFlow bge-m3。查询接口本身也会调用一次 LLM 抽关键词。
ECHOTALK_LIGHTRAG_ENABLED=true
ECHOTALK_LIGHTRAG_LLM_API_BASE=https://api.siliconflow.cn/v1
ECHOTALK_LIGHTRAG_LLM_API_KEY=replace-with-your-llm-api-key
ECHOTALK_LIGHTRAG_LLM_MODEL=deepseek-ai/DeepSeek-V3
ECHOTALK_LIGHTRAG_LLM_TIMEOUT=120
