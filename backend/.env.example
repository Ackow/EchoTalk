# 本地 MySQL 连接信息。复制为 .env 后填写实际密码。
ECHOTALK_DB_HOST=127.0.0.1
ECHOTALK_DB_PORT=3307
ECHOTALK_DB_NAME=echotalk
ECHOTALK_DB_USER=echotalk_app
ECHOTALK_DB_PASSWORD=replace-with-your-password

# 本机默认只监听回环地址；部署时设为 0.0.0.0 并仅通过 HTTPS 反向代理对外提供 API。
ECHOTALK_API_HOST=127.0.0.1
ECHOTALK_API_PORT=8000

# 本地桌面开发来源。生产时替换为实际网页域名；打包 Electron 使用 file:// 时保留 null。
ECHOTALK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
