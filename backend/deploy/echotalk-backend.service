# EchoTalk 2.0 API systemd 服务单元
# 安装：sudo cp echotalk-backend.service /etc/systemd/system/
#       sudo systemctl daemon-reload && sudo systemctl enable --now echotalk-backend
# 前提：代码位于 /opt/echotalk，虚拟环境由 uv sync 创建于 backend/.venv
#       运行用户为 deploy（如不同请同步修改 User 与路径）

[Unit]
Description=EchoTalk 2.0 API (FastAPI + uvicorn)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/echotalk/backend
ExecStart=/opt/echotalk/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# .env 由应用自行从 WorkingDirectory 加载，无需在此重复配置

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
