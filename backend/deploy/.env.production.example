# 云端生产环境配置模板（Ubuntu 服务器）
# 用法：复制到服务器 backend/.env 后，改掉 DB_PASSWORD 和域名。
# MySQL 与 API 均部署在本机；API 监听地址见下方说明。

# ---- MySQL（与 API 同机，默认只走本机回环，不对外开放 3306）----
ECHOTALK_DB_HOST=127.0.0.1
ECHOTALK_DB_PORT=3306
ECHOTALK_DB_NAME=echotalk
ECHOTALK_DB_USER=echotalk_app
ECHOTALK_DB_PASSWORD=replace-with-strong-password

# ---- API 监听地址 ----
# 0.0.0.0：外部可直接访问 http://<服务器IP>:8000（测试期方便，需在云安全组放行 8000）
# 127.0.0.1：仅本机可访问，对外统一走 Nginx 的 80/443（正式部署推荐）
ECHOTALK_API_HOST=0.0.0.0
ECHOTALK_API_PORT=8000

# ---- 文件存储根目录（可选）----
# 场景封面/知识资料等落盘文件的根目录，默认 backend/storage/
# 建议指向独立数据盘，代码更新（git pull）不会影响用户文件；例如：
# ECHOTALK_STORAGE_ROOT=/data/echotalk/storage

# ---- CORS：允许访问后端的页面来源，逗号分隔 ----
# Electron 打包版使用 file:// 时 Origin 为 null，必须保留 null
# 本地前端开发（Vite dev server）与本地调试
ECHOTALK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null
# 正式部署网页端时换成实际域名，例如：https://your-domain.com,null
