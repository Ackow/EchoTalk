{
  "name": "echotalk-frontend",
  "version": "2.0.0",
  "description": "EchoTalk 2.0 account and workspace shell",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && npm run electron:start\"",
    "pack": "npm run build && electron-builder",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@milkdown/kit": "^7.22.2",
    "axios": "^1.6.8",
    "echarts": "^6.1.0",
    "marked": "^18.0.14",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.echotalk.app",
    "productName": "EchoTalk",
    "directories": {
      "output": "dist_electron"
    },
    "protocols": [
      {
        "name": "EchoTalk",
        "schemes": [
          "echotalk"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Ackow",
        "repo": "EchoTalk"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "public/app-icon.png",
      "category": "public.app-category.education",
      "artifactName": "EchoTalk-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico",
      "artifactName": "EchoTalk-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EchoTalk"
    }
  }
}
